# Example environment variables for backend
# Do NOT commit real API keys. Copy to .env and fill values.

# Hugging Face Inference API key
HF_API_KEY=

# Model to use for summarization (default recommended for demo)
HF_MODEL=google/flan-t5-base

# Firebase service account JSON can be provided via FIREBASE_SERVICE_ACCOUNT_JSON
# or via GOOGLE_APPLICATION_CREDENTIALS pointing to a service account file.
FIREBASE_SERVICE_ACCOUNT_JSON=
